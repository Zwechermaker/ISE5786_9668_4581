<scene background-color="15 20 30">
    <ambient-light color="30 35 45" />

    <!-- Bright, stadium-like overhead lights to mimic arena lighting -->
    <point-light color="900 900 1000" position="0 0 120" kL="0.001" kQ="0.00005" />
    <spot-light color="400 400 500" position="-80 0 100" direction="0.6 0 -0.8" kL="0.0002" kQ="0.00001" />
    <spot-light color="400 400 500" position="80 0 100" direction="-0.6 0 -0.8" kL="0.0002" kQ="0.00001" />

    <geometries>
        <!-- ================================================================= -->
        <!-- ICE HOCKEY RINK                                                   -->
        <!-- ================================================================= -->

        <!-- Ice Surface (Highly reflective, slightly transparent white plane) -->
        <plane p0="0 0 0" normal="0 0 1" kD="0.9 0.95 1.0" kS="0.95" nShininess="500" kT="0.1" kR="0.4" />

        <!-- Rink Center Red Line & Faceoff Circle -->
        <cylinder axis-origin="0 0 0.01" axis-direction="0 0 1" radius="30" height="0.02" kD="0.8 0.1 0.1" />
        <cylinder axis-origin="0 0 0.02" axis-direction="0 0 1" radius="29.5" height="0.02" kD="0.9 0.95 1.0" />
        <polygon p0="-100 -1 0.03" p1="100 -1 0.03" p2="100 1 0.03" p3="-100 1 0.03" kD="0.8 0.1 0.1" />

        <!-- Blue Lines -->
        <polygon p0="-100 -25 0.03" p1="100 -25 0.03" p2="100 -23 0.03" p3="-100 -23 0.03" kD="0.1 0.2 0.8" />
        <polygon p0="-100 23 0.03" p1="100 23 0.03" p2="100 25 0.03" p3="-100 25 0.03" kD="0.1 0.2 0.8" />

        <!-- Rink Boards (Dasher Boards - Surrounding Walls) -->
        <!-- Straight sections -->
        <polygon p0="-50 -80 0" p1="50 -80 0" p2="50 -80 15" p3="-50 -80 15" kD="0.85 0.85 0.85" kS="0.3" nShininess="20" />
        <polygon p0="-50 80 0" p1="50 80 0" p2="50 80 15" p3="-50 80 15" kD="0.85 0.85 0.85" kS="0.3" nShininess="20" />
        <polygon p0="-50 -80 0" p1="-50 80 0" p2="-50 80 15" p3="-50 -80 15" kD="0.85 0.85 0.85" kS="0.3" nShininess="20" />
        <polygon p0="50 -80 0" p1="50 80 0" p2="50 80 15" p3="50 -80 15" kD="0.85 0.85 0.85" kS="0.3" nShininess="20" />

        <!-- Yellow Kick Strip at the bottom of the boards -->
        <polygon p0="-50 -79.9 0" p1="50 -79.9 0" p2="50 -79.9 1.5" p3="-50 -79.9 1.5" kD="0.9 0.7 0.1" />
        <polygon p0="-50 79.9 0" p1="50 79.9 0" p2="50 79.9 1.5" p3="-50 79.9 1.5" kD="0.9 0.7 0.1" />

        <!-- ================================================================= -->
        <!-- HOCKEY EQUIPMENT: HOCKEY STICKS & PUCKS                           -->
        <!-- ================================================================= -->

        <!-- Hockey Puck 1 (Near center ice) -->
        <!-- Solid, flat, matte black vulcanized rubber cylinder -->
        <cylinder axis-origin="5 10 0" axis-direction="0 0 1" radius="1.5" height="1.0" kD="0.05 0.05 0.05" kS="0.1" nShininess="5" />

        <!-- Hockey Puck 2 (Near the boards) -->
        <cylinder axis-origin="-30 -40 0" axis-direction="0 0 1" radius="1.5" height="1.0" kD="0.05 0.05 0.05" kS="0.1" nShininess="5" />

        <!-- Hockey Stick 1 (Composite shaft and blade resting on ice) -->
        <!-- Shaft -->
        <cylinder axis-origin="10 12 0.5" axis-direction="0.2 1 0.3" radius="0.4" height="25" kD="0.1 0.5 0.8" kS="0.6" nShininess="50" />
        <!-- Blade (constructed via connected polygons) -->
        <polygon p0="10 12 0.1" p1="14 11 0.1" p2="14 11 1.5" p3="10 12 1.5" kD="0.1 0.1 0.1" />
        <polygon p0="14 11 0.1" p1="18 9 0.1" p2="18 9 1.5" p3="14 11 1.5" kD="0.1 0.1 0.1" />

        <!-- Hockey Stick 2 (Classic wood style stick) -->
        <!-- Shaft -->
        <cylinder axis-origin="-15 -10 0.5" axis-direction="-0.1 1 0.4" radius="0.4" height="22" kD="0.5 0.35 0.2" kS="0.2" nShininess="10" />
        <!-- Blade -->
        <polygon p0="-15 -10 0.1" p1="-12 -8 0.1" p2="-12 -8 1.5" p3="-15 -10 1.5" kD="0.8 0.8 0.8" />
        <polygon p0="-12 -8 0.1" p1="-8 -7 0.1" p2="-8 -7 1.5" p3="-12 -8 1.5" kD="0.8 0.8 0.8" />

        <!-- ================================================================= -->
        <!-- THE "ELAD ZWECHER" HONORARY SIGN                                  -->
        <!-- ================================================================= -->

        <!-- Signposts (Two metallic tubes holding the billboard) -->
        <tube axis-origin="55 -20 0" axis-direction="0 0 1" radius="0.8" kD="0.6 0.6 0.6" kS="0.8" nShininess="100" />
        <tube axis-origin="55 20 0" axis-direction="0 0 1" radius="0.8" kD="0.6 0.6 0.6" kS="0.8" nShininess="100" />

        <!-- Sign Background Board (Glowing magical gold/fiery framing) -->
        <polygon p0="55 -22 15" p1="55 22 15" p2="55 22 35" p3="55 -22 35" kD="0.7 0.5 0.1" kS="0.9" nShininess="200" />
        <!-- Inner Board Canvas -->
        <polygon p0="54.9 -21 16" p1="54.9 21 16" p2="54.9 21 34" p3="54.9 -21 34" kD="0.05 0.05 0.1" emission="1 0.8 0.2" />

        <!-- Magical Wizardly/Fireman Details on the Board (Geometric representations of text & theme) -->
        <!-- Fire / Wizard Hat Top Accent (Red/Orange Triangle) -->
        <triangle p0="54.8 -5 30" p1="54.8 5 30" p2="54.8 0 33" kD="0.9 0.2 0.1" emission="2 0.5 0" />

        <!-- Styled "Text" Line 1: "ELAD ZWECHER" (Represented by bold golden geometric elements) -->
        <polygon p0="54.7 -18 26" p1="54.7 -8 26" p2="54.7 -8 28" p3="54.7 -18 28" kD="0.9 0.8 0.2" emission="3 2.5 0.5" />
        <polygon p0="54.7 -6 26" p1="54.7 6 26" p2="54.7 6 28" p3="54.7 -6 28" kD="0.9 0.8 0.2" emission="3 2.5 0.5" />
        <polygon p0="54.7 8 26" p1="54.7 18 26" p2="54.7 18 28" p3="54.7 8 28" kD="0.9 0.8 0.2" emission="3 2.5 0.5" />

        <!-- Styled "Text" Line 2: "IS THE MOST FABULOUS" (Glowing cyan/magenta magical runes) -->
        <polygon p0="54.7 -15 22" p1="54.7 -2 22" p2="54.7 -2 23.5" p3="54.7 -15 23.5" kD="0.2 0.8 0.9" emission="0.5 3 4" />
        <polygon p0="54.7 2 22" p1="54.7 15 22" p2="54.7 15 23.5" p3="54.7 2 23.5" kD="0.2 0.8 0.9" emission="0.5 3 4" />

        <!-- Styled "Text" Line 3: "WIZARD AND FIREMAN" (Deep mystical red and emergency bright orange blocks) -->
        <!-- Wizard Emblem (Glowing Sphere floating just in front of the wizard part of the text) -->
        <sphere center="54.0 -8 19" radius="1.2" emission="5 2 10" kD="0.1" kS="0.9" nShininess="300" kT="0.5" />
        <polygon p0="54.7 -12 18" p1="54.7 -2 18" p2="54.7 -2 20" p3="54.7 -12 18" kD="0.5 0.1 0.8" emission="2 0 4" />

        <!-- Fireman Emblem (Bright Red Emergency Flasher Sphere) -->
        <sphere center="54.0 8 19" radius="1.2" emission="10 2 1" kD="0.1" kS="0.9" nShininess="300" />
        <polygon p0="54.7 2 18" p1="54.7 12 18" p2="54.7 12 20" p3="54.7 2 18" kD="0.9 0.1 0.1" emission="4 0.5 0" />
    </geometries>
</scene>